{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "theme": "dark",
  "defaultThinkingLevel": "medium",
  "transport": "sse",
  "packages": [
    {
      "source": "npm:@axnic/pi-extension-settings",
      "extensions": [
        "-dist/index.js"
      ]
    },
    "npm:pi-markdown-preview",
    "npm:pi-ask-user",
    "npm:pi-btw",
    "npm:pi-extension-manager",
    {
      "source": "npm:pi-caveman",
      "extensions": [
        "-extensions/caveman.ts"
      ]
    },
    {
      "source": "npm:@coreinfra/pi-plugin@latest",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "npm:pi-web-access",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:pi-mcp-adapter",
    {
      "source": "npm:pi-protected-paths",
      "extensions": [
        "-index.ts"
      ]
    },
    {
      "source": "npm:@sreetej510/pi-usage",
      "extensions": [
        "-dist/index.js"
      ]
    },
    "npm:@npm-ken/pi-macos-notify",
    "npm:@indexyz/pi-continue",
    "npm:pi-session-finder"
  ],
  "extensions:settings": {
    "pi-extension-settings": {
      "behavior.start-in-search-mode": false
    }
  },
  "tuiMode": "fullscreen",
  "treeFilterMode": "labeled-only",
  "quietStartup": false,
  "markdown": {
    "mermaid": "streaming"
  },
  "followUpMode": "all",
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true
  },
  "showHardwareCursor": false
}
